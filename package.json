{
  "name": "github-repositories-fllow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter server dev",
    "build": "pnpm -r build",
    "build:lambda": "pnpm --filter server build",
    "build:web": "pnpm --filter web build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build:go-image": "docker build --platform linux/arm64 -t github-repositories-fllow-go:local apps/go-api",
    "db:push": "pnpm --filter @github-repositories-fllow/db db:push",
    "db:studio": "pnpm --filter @github-repositories-fllow/db db:studio",
    "db:generate": "pnpm --filter @github-repositories-fllow/db db:generate",
    "db:migrate": "pnpm --filter @github-repositories-fllow/db db:migrate"
  },
  "dependencies": {
    "@github-repositories-fllow/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@github-repositories-fllow/config": "workspace:*",
    "@types/node": "^22.13.14",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
